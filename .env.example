# Account used to sign in to the Qiyu portal.
NAS_USERNAME=admin
NAS_PASSWORD=change-this-to-a-long-random-password

# Private Jellyfin service account. It is used only by Qiyu's server-side
# media client, never exposed to the browser, and may differ from NAS_*.
# On a new installation these credentials create Jellyfin's first account.
JELLYFIN_USERNAME=qiyu-service
JELLYFIN_PASSWORD=change-this-to-a-different-long-random-password
# Private Docker URL; append Jellyfin's configured Base URL when one exists.
JELLYFIN_BASE_URL=http://jellyfin:8096

# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=replace-with-a-random-64-character-secret

# Host paths. Absolute paths are recommended for production deployments.
NAS_ROOT=./data
CONFIG_ROOT=./config

# Container access must match the owner of NAS_ROOT and CONFIG_ROOT on Linux.
PUID=1000
PGID=1000

NAS_HOSTNAME=qiyu-nas
# The default Compose mapping listens on both IPv4 and IPv6. Do not set a
# bind address here unless you intentionally replace the port mapping.
PORTAL_PORT=8080

# Set to true only when Caddy is served through HTTPS.
PORTAL_COOKIE_SECURE=false

# Use the public registry by default. A mirror can be substituted when needed.
NPM_REGISTRY=https://registry.npmjs.org/

# Maximum size of one media collection task. Accepts yt-dlp size values, e.g. 2G.
COLLECTOR_MAX_FILESIZE=10G

# Video collection height cap. 1440 means 2K/QHD; valid range is 144 to 2160.
COLLECTOR_MAX_HEIGHT=1440

# Optional collector build overrides for networks that require an internally
# trusted certificate authority. Leave empty on ordinary Internet connections.
COLLECTOR_BASE=alpine:3.22
COLLECTOR_EXTRA_CA_CERTIFICATE_B64=
