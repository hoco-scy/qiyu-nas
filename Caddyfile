{
  admin off
  auto_https off
}

:80 {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }

  redir /jellyfin /jellyfin/ 308
  # Keep Jellyfin's internal API at its native root while exposing it below
  # the portal's maintenance route.
  handle_path /jellyfin/* {
    reverse_proxy jellyfin:8096
  }

  # Site discovery belongs to the portal. Caddy only serves an individual
  # static site, so its built-in directory browsing is never exposed.
  redir /sites /websites 308
  redir /sites/ /websites 308
  handle_path /sites/* {
    root * /srv/sites
    file_server
  }

  handle {
    reverse_proxy portal:3000
  }
}
